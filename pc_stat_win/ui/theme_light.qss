/* PC Stat — светлая тема (мягкая, без «кислотных» контрастов) */

QWidget {
    background-color: #e8eaef;
    color: #3c4250;
    font-size: 13px;
    selection-background-color: #c8d0de;
    selection-color: #252830;
}

QMainWindow, QTabWidget::pane {
    background-color: #e8eaef;
}

QTabWidget::pane {
    border: 1px solid #c9ced8;
    border-radius: 8px;
    top: -1px;
    padding: 8px;
    background-color: #f0f1f4;
}

QTabBar::tab {
    background-color: #dcdfe6;
    color: #5c6370;
    padding: 10px 18px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 72px;
}

QTabBar::tab:selected {
    background-color: #f0f1f4;
    color: #2a2f38;
    font-weight: 600;
    border-bottom: 2px solid #7d8699;
}

QTabBar::tab:hover:!selected {
    background-color: #d0d5df;
}

QLabel {
    color: #3c4250;
}

QLabel#summaryLabel {
    background-color: #f4f5f7;
    border: 1px solid #c9ced8;
    border-radius: 10px;
    padding: 14px 16px;
    color: #4a5160;
}

QLabel#periodStatsLabel {
    color: #6b7280;
    font-size: 12px;
    padding: 4px 2px 8px 2px;
}

QLabel#reportsSummary {
    background-color: #f4f5f7;
    border: 1px solid #c9ced8;
    border-radius: 8px;
    padding: 12px;
    color: #4a5160;
}

QFrame#card {
    background-color: #eeeff2;
    border: 1px solid #cfd4dc;
    border-radius: 12px;
    padding: 8px;
}

QPushButton#btnExport {
    background-color: #aeb8c9;
    color: #1f2329;
}

QGroupBox#top5Group {
    margin-top: 8px;
}

QProgressBar {
    border: 1px solid #bfc6d2;
    border-radius: 6px;
    text-align: center;
    background-color: #e2e5eb;
    color: #3c4250;
    min-height: 20px;
}

QProgressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #9aa8bc, stop:1 #aeb9c8);
}

QLineEdit, QDoubleSpinBox, QComboBox {
    background-color: #f6f7f9;
    border: 1px solid #bfc6d2;
    border-radius: 6px;
    padding: 8px 10px;
    color: #3c4250;
    selection-background-color: #c8d0de;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #f6f7f9;
    color: #3c4250;
    selection-background-color: #d8dde6;
}

QLineEdit:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #8b95a8;
}

QGroupBox {
    font-weight: 600;
    color: #353a44;
    border: 1px solid #c9ced8;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    background-color: #f0f1f4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
}

QPushButton {
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: 600;
    color: #252830;
    min-height: 20px;
}

/* Периоды: приглушённые «пыльные» оттенки, без радуги */
QPushButton#periodToday {
    background-color: #b8c5d4;
    color: #1f2329;
}

QPushButton#periodWeek {
    background-color: #c4bfd0;
    color: #1f2329;
}

QPushButton#periodMonth {
    background-color: #b5c4b8;
    color: #1f2329;
}

QPushButton#periodYear {
    background-color: #ccc4b0;
    color: #1f2329;
}

QPushButton#periodAll {
    background-color: #a8bdb8;
    color: #1f2329;
}

QTableWidget {
    gridline-color: #d5dae2;
    background-color: #f6f7f9;
    alternate-background-color: #eceef2;
    border: 1px solid #c9ced8;
    border-radius: 8px;
    padding: 4px;
}

QTableWidget::item {
    padding: 8px 6px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #d8dde6;
    color: #252830;
}

QHeaderView::section {
    background-color: #e2e5eb;
    color: #5c6370;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #bfc6d2;
    font-weight: 600;
}

QHeaderView::section:first {
    border-top-left-radius: 6px;
}

QHeaderView::section:last {
    border-top-right-radius: 6px;
}

QScrollBar:vertical {
    background: #e2e5eb;
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #aeb8c9;
    min-height: 32px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #9aa3b3;
}

QScrollBar:horizontal {
    background: #e2e5eb;
    height: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #aeb8c9;
    min-height: 12px;
    border-radius: 6px;
}

QMenu {
    background-color: #f6f7f9;
    border: 1px solid #c9ced8;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #d8dde6;
}

/* QtCharts: фон в тон интерфейсу (иначе остаётся «больничный» белый) */
QChartView {
    background-color: #f0f1f4;
    border: 1px solid #c9ced8;
    border-radius: 8px;
}
