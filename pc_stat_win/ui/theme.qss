/* PC Stat 1.3 - shared semantic glass theme template */

QWidget {
    background-color: transparent;
    color: ${text};
    font-family: "Segoe UI Variable", "Segoe UI", "Arial", "Tahoma", "Microsoft Sans Serif";
    font-size: 13px;
    selection-background-color: ${selection_strong};
    selection-color: ${selection_text};
}

QMainWindow,
QDialog {
    background-color: ${window};
}

QMainWindow[windowMaterial="mica"] {
    background-color: ${window_tint};
}

QMainWindow[windowMaterial="solid"],
QDialog[windowMaterial="solid"] {
    background-color: ${window};
}

QFrame#card,
QFrame#kpiCard,
QFrame#glassSurface,
QFrame#reportNavigator,
QFrame#screenTimeCard,
QWidget#glassSurface,
QFrame[glass="true"],
QWidget[glass="true"],
QLabel#summaryLabel,
QLabel#reportsSummary,
QTabWidget::pane,
QGroupBox {
    background-color: ${surface_glass};
    border: 1px solid ${border};
    border-radius: 8px;
}

QFrame#navigationSurface {
    background-color: ${surface_glass_strong};
    border: 1px solid ${border};
    border-radius: 8px;
}

QFrame#glassSurface[elevated="true"] {
    background-color: ${surface_glass_strong};
    border-color: ${border_strong};
}

QWidget#pageContent,
QScrollArea#pageScroll,
QScrollArea#pageScroll > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QWidget#windowSurface {
    background-color: ${window};
    border: none;
}

QWidget#periodSegmentHost {
    background-color: ${surface_pressed};
    border: 1px solid ${border};
    border-radius: 8px;
}

QFrame#card {
    padding: 6px;
}

QFrame#kpiCard {
    background-color: ${surface_glass_strong};
    padding: 8px;
}

QFrame#metricBlock {
    background-color: ${surface_inner};
    border: 1px solid ${border};
    border-left: 3px solid ${accent};
    border-radius: 8px;
}

QFrame#metricBlock:hover {
    background-color: ${surface_hover};
    border-color: ${border_strong};
}

QFrame#metricBlock[metricTone="blue"] {
    border-left: 3px solid ${tone_blue};
}

QFrame#metricBlock[metricTone="teal"] {
    border-left: 3px solid ${tone_teal};
}

QFrame#metricBlock[metricTone="violet"] {
    border-left: 3px solid ${tone_violet};
}

QFrame#metricBlock[metricTone="amber"] {
    border-left: 3px solid ${tone_amber};
}

QFrame#metricBlock[metricTone="rose"] {
    border-left: 3px solid ${tone_rose};
}

QFrame#metricBlock[metricTone="slate"] {
    border-left: 3px solid ${tone_slate};
}

QFrame#screenTimeCard,
QFrame#reportNavigator {
    background-color: ${surface_glass_strong};
}

QLabel {
    color: ${text};
}

QLabel#summaryLabel,
QLabel#reportsSummary {
    color: ${text_muted};
    padding: 12px;
}

QLabel#periodStatsLabel,
QLabel#kpiLabel {
    color: ${text_muted};
    font-size: 12px;
}

QLabel#periodStatsLabel {
    padding: 4px 2px 8px 2px;
}

QLabel#kpiValue {
    color: ${text};
    font-size: 18px;
    font-weight: 700;
}

QLabel#brandTitle {
    color: ${text};
    font-size: 20px;
    font-weight: 700;
}

QLabel#pageTitle {
    color: ${text};
    font-size: 18px;
    font-weight: 700;
}

QLabel#sectionTitle {
    color: ${text};
    font-size: 14px;
    font-weight: 600;
}

QLabel#secondaryText {
    color: ${text_muted};
}

QLabel#metricValue {
    color: ${text};
    font-size: 18px;
    font-weight: 700;
}

QLabel#periodRangeTitle {
    color: ${text};
    font-size: 15px;
    font-weight: 600;
}

QLabel#reportHeroValue {
    color: ${text};
    font-size: 32px;
    font-weight: 700;
}

QLabel#comparisonText {
    color: ${text_muted};
    font-size: 13px;
}

QLabel#reportCategoryName {
    font-size: 13px;
    font-weight: 600;
}

QLabel#reportCategoryValue,
QLabel#reportTotalValue,
QLabel#usageDuration,
QLabel#usageName {
    color: ${text};
    font-weight: 600;
}

QFrame#reportDivider {
    background-color: ${border};
    border: none;
}

QLabel#statusOk {
    color: ${success};
    background-color: ${success_bg};
    border: 1px solid ${success};
    border-radius: 6px;
    padding: 4px 6px;
}

QLabel#statusError {
    color: ${danger};
    background-color: ${danger_bg};
    border: 1px solid ${danger};
    border-radius: 6px;
    padding: 4px 6px;
}

QTabWidget::pane {
    top: -1px;
    padding: 8px;
}

QTabBar::tab {
    background-color: transparent;
    color: ${text_muted};
    border: 2px solid transparent;
    border-radius: 6px;
    min-height: 36px;
    padding: 0 16px;
    margin-right: 4px;
}

QTabBar::tab:hover:!selected {
    background-color: ${surface_hover};
}

QTabBar::tab:selected {
    background-color: ${surface_glass_strong};
    color: ${text};
    border-color: ${border_strong};
    font-weight: 600;
}

QTabBar::tab:focus {
    border: 2px solid ${accent};
}

QGroupBox {
    color: ${text};
    font-weight: 600;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
}

QPushButton,
QToolButton,
QLineEdit,
QDoubleSpinBox,
QSpinBox,
QComboBox {
    background-color: ${surface_glass_strong};
    color: ${text};
    border: 2px solid ${control_border};
    border-radius: 8px;
    min-height: 36px;
    max-height: 36px;
    padding: 0 12px;
}

QPushButton {
    font-weight: 600;
}

QToolButton {
    background-color: ${surface_glass_strong};
    color: ${text};
    border: 2px solid ${control_border};
    border-radius: 8px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton:hover,
QToolButton:hover,
QLineEdit:hover,
QDoubleSpinBox:hover,
QSpinBox:hover,
QComboBox:hover {
    background-color: ${surface_hover};
    border-color: ${control_border_strong};
}

QPushButton:pressed {
    background-color: ${surface_pressed};
}

QToolButton:pressed {
    background-color: ${surface_pressed};
}

QPushButton:focus,
QToolButton:focus,
QLineEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus,
QComboBox:focus,
QCheckBox:focus {
    border: 2px solid ${accent};
}

QPushButton:disabled,
QToolButton:disabled,
QLineEdit:disabled,
QDoubleSpinBox:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    background-color: ${surface_disabled};
    color: ${text_disabled};
    border-color: ${border};
}

QPushButton[navigation="true"] {
    background-color: transparent;
    border-color: transparent;
    color: ${text_muted};
    text-align: left;
    padding: 0 10px;
}

QPushButton[navigation="true"]:hover {
    background-color: ${surface_hover};
    color: ${text};
}

QPushButton[navigation="true"]:checked {
    background-color: ${selection_strong};
    border-color: ${border_strong};
    color: ${text};
    font-weight: 700;
}

QPushButton[navigation="true"]:checked:focus {
    border-color: ${accent};
}

QPushButton[navigation="true"][compactNavigation="true"] {
    text-align: center;
    padding: 0;
}

QPushButton[danger="true"],
QToolButton[danger="true"] {
    color: ${danger};
}

QPushButton[danger="true"]:hover,
QToolButton[danger="true"]:hover {
    background-color: ${danger_bg};
    border-color: ${danger};
}

QPushButton[flatAction="true"] {
    background-color: transparent;
    color: ${accent};
    border-color: transparent;
    padding: 0 8px;
}

QPushButton[flatAction="true"]:hover {
    background-color: ${accent_soft};
    border-color: transparent;
}

QPushButton#btnExport,
QPushButton[primary="true"],
QPushButton[segment="true"][selected="true"],
QPushButton[segment="true"]:checked,
QPushButton#periodToday[selected="true"],
QPushButton#periodWeek[selected="true"],
QPushButton#periodMonth[selected="true"],
QPushButton#periodYear[selected="true"],
QPushButton#periodAll[selected="true"] {
    background-color: ${accent};
    color: ${accent_text};
    border-color: ${accent};
}

QPushButton#btnExport:hover,
QPushButton[primary="true"]:hover,
QPushButton[segment="true"][selected="true"]:hover,
QPushButton[segment="true"]:checked:hover {
    background-color: ${accent_hover};
    border-color: ${accent_hover};
}

QPushButton#btnExport:pressed,
QPushButton[primary="true"]:pressed,
QPushButton[segment="true"][selected="true"]:pressed,
QPushButton[segment="true"]:checked:pressed {
    background-color: ${accent_pressed};
    border-color: ${accent_pressed};
}

QPushButton[segment="true"],
QPushButton#periodToday,
QPushButton#periodWeek,
QPushButton#periodMonth,
QPushButton#periodYear,
QPushButton#periodAll {
    background-color: ${surface_glass_strong};
    color: ${text};
}

QWidget#periodSegmentHost QPushButton[segment="true"] {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    min-height: 32px;
    max-height: 32px;
    padding: 0 12px;
}

QWidget#periodSegmentHost QPushButton[segment="true"]:hover:!checked {
    background-color: ${surface_hover};
}

QWidget#periodSegmentHost QPushButton[segment="true"]:checked {
    background-color: ${accent};
    color: ${accent_text};
    border-color: ${accent};
}

QComboBox::drop-down,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button,
QSpinBox::up-button,
QSpinBox::down-button {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView,
QMenu {
    background-color: ${surface};
    color: ${text};
    border: 1px solid ${border_strong};
    border-radius: 8px;
    padding: 4px;
    selection-background-color: ${selection_strong};
    selection-color: ${selection_text};
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 4px 8px;
}

QMenu::item {
    border-radius: 6px;
    min-height: 30px;
    padding: 2px 24px;
}

QMenu::item:selected {
    background-color: ${selection_strong};
}

QCheckBox {
    color: ${text};
    spacing: 8px;
    border: 2px solid transparent;
    border-radius: 6px;
    min-height: 32px;
}

QCheckBox:disabled {
    color: ${text_disabled};
}

QProgressBar {
    background-color: ${surface_glass_strong};
    color: ${text};
    border: 1px solid ${border};
    border-radius: 6px;
    min-height: 20px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: ${accent};
    border-radius: 5px;
}

QProgressBar[compact="true"] {
    background-color: ${surface_pressed};
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 7px;
}

QProgressBar[compact="true"]::chunk {
    border-radius: 3px;
}

QTableView,
QTableWidget {
    background-color: ${surface_glass};
    alternate-background-color: ${surface_glass_strong};
    color: ${text};
    gridline-color: transparent;
    border: 2px solid ${control_border};
    border-radius: 8px;
    selection-background-color: ${selection_strong};
    selection-color: ${selection_text};
}

QTableView:focus,
QTableWidget:focus {
    border: 2px solid ${accent};
}

QTableView:hover,
QTableWidget:hover {
    border-color: ${control_border_strong};
}

QTableView::item,
QTableWidget::item {
    min-height: 36px;
    padding: 4px 8px;
    border: none;
}

QTableView::item:hover,
QTableWidget::item:hover {
    background-color: ${surface_hover};
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: ${selection_strong};
    color: ${selection_text};
}

QHeaderView::section {
    background-color: ${surface_glass_strong};
    color: ${text_muted};
    border: none;
    border-bottom: 1px solid ${border_strong};
    min-height: 36px;
    padding: 0 8px;
    font-weight: 600;
}

QToolButton[reportNavigation="true"] {
    background-color: ${surface_inner};
    border-color: ${border};
    color: ${text};
    font-size: 24px;
    font-weight: 700;
    padding: 0;
}

QToolButton[reportNavigation="true"]:hover {
    background-color: ${accent_soft};
    border-color: ${accent};
}

QToolButton[reportNavigation="true"]:disabled {
    color: ${text_disabled};
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: ${scroll_track};
    border: none;
    border-radius: 6px;
    margin: 0;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: ${scroll_handle};
    border-radius: 6px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: ${control_border_strong};
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}

QToolTip {
    background-color: ${surface};
    color: ${text};
    border: 1px solid ${border_strong};
    border-radius: 6px;
    padding: 6px;
}

QChartView {
    background-color: transparent;
    border: none;
}
